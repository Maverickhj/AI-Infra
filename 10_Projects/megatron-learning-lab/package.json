{
  "name": "megatron-learning-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "env -u PYTHONPATH uv run --no-project python -S tools/build_case_data.py && npm run data:decoder && npm run data:parallel",
    "predev": "npm run data",
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "prebuild": "npm run data",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "test:e2e": "playwright test",
    "test:metadata": "env -u PYTHONPATH uv run --no-project python -S -m unittest discover -s tests -v && uv run --no-project python -S tools/verify_handoff.py",
    "format": "prettier --write web tests/browser playwright.config.ts",
    "pretest:metadata": "npm run data",
    "test:gqa": "node --experimental-strip-types tests/gqa-numeric.mjs",
    "test:sft-data": "node --experimental-strip-types tests/sft-data.mjs",
    "test:decoder": "node --experimental-strip-types tests/decoder-numeric.mjs",
    "data:decoder": "env -u PYTHONPATH CUDA_VISIBLE_DEVICES= python -m experiments.decoder_reference --export content/generated/decoder-cpu.json",
    "test:tp-dp": "node --experimental-strip-types tests/tp-dp.mjs",
    "data:parallel": "env -u PYTHONPATH CUDA_VISIBLE_DEVICES= python -m experiments.tp_dp_reference --export content/generated/tp-dp-cpu.json",
    "test:sequence": "node --experimental-strip-types tests/sequence.mjs",
    "test:moe-mla": "node --experimental-strip-types tests/moe-mla.mjs",
    "test:rl-reference": "node --experimental-strip-types tests/rl-reference.mjs",
    "test:runtime-contracts": "node --experimental-strip-types tests/runtime-contracts.mjs"
  },
  "dependencies": {
    "katex": "0.18.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
